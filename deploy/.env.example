# Copy to /opt/polticool/.env on the server and fill in. Never commit the real file.
#   openssl rand -hex 24   -> POSTGRES_PASSWORD
#   openssl rand -base64 48 | tr -d '\n'  -> SECRET_KEY_BASE (or `mix phx.gen.secret`)
POSTGRES_PASSWORD=change-me
SECRET_KEY_BASE=change-me-at-least-64-bytes
ANTHROPIC_API_KEY=
